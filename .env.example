# ─────────────────────────────────────────────────────────────────────────────
# Chat Report MVP — environment variables
# Copy this file to `.env.local` and fill in real values. NEVER commit `.env*`.
# ─────────────────────────────────────────────────────────────────────────────

# Generation mode — WHERE the report-writing call goes. Same prompt in all three:
#   claude-code — local Claude Code CLI, your subscription, no API key (dev default)
#   api         — real Anthropic API, needs ANTHROPIC_API_KEY (production default)
#   mock        — canned sample report, no AI call at all
# The default depends on NODE_ENV: "claude-code" locally, "api" in production.
# claude-code CANNOT work on a server — there's no CLI and no login there — so
# production refuses it outright rather than failing deep inside the job.
GEN_MODE=claude-code

# Anthropic — the one paid piece. Writes the report. Only read when GEN_MODE=api.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Optional: override the model. Defaults to claude-sonnet-5 (docs spec names Sonnet).
# Cheaper: claude-haiku-4-5. Dearer/sharper: claude-opus-4-8.
# Also used as the --model passed to the Claude Code CLI when GEN_MODE=claude-code.
ANTHROPIC_MODEL=claude-sonnet-5

# Large chats (see lib/chunking.ts) split into map-reduce: a cheap/fast model
# analyzes each chunk, the main model writes the final report from those
# analyses. Both optional — swap independently for A/B testing.
#   MAP_MODEL    — defaults to claude-haiku-4-5 if unset.
#   REDUCE_MODEL — defaults to ANTHROPIC_MODEL (above) if unset, i.e. the same
#                  model normal single-call chats already use.
MAP_MODEL=claude-haiku-4-5
REDUCE_MODEL=

# Inngest — runs the long generation job (free tier).
# From the Inngest dashboard → your app → Keys. For local dev with the Inngest
# Dev Server these can be left blank.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Supabase — stores the finished report + share tokens (free tier).
# Project Settings → API. Use the SERVICE ROLE key (server-side only, never
# expose to the browser).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — emails the report link (free tier). Optional — the link is the real
# deliverable, so the app still works without this (it just logs the link).
RESEND_API_KEY=
# The verified "from" address for report emails.
RESEND_FROM="{{PERSONA_NAME}} <reports@yourdomain.com>"

# Public base URL of the app — used to build the report link in emails.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe — the paywall. One-time payment per report; unlocks the full text
# (unpaid visitors see headline stats only, rest blurred).
# Secret key: Stripe dashboard → Developers → API keys.
STRIPE_SECRET_KEY=
# Webhook signing secret: Stripe dashboard → Developers → Webhooks → add an
# endpoint for POST {NEXT_PUBLIC_APP_URL}/api/stripe/webhook, listening for
# checkout.session.completed → reveal its "Signing secret" (whsec_...).
# Register the endpoint in the SAME environment you're testing in — a sandbox
# payment is not delivered to a live-mode endpoint, and it fails silently.
# This is the primary way a report gets marked paid, and the only one that
# works if the buyer closes the tab the moment they've paid. It is no longer
# the only one: lib/checkoutStatus.ts asks Stripe directly when the report
# page loads an unpaid report that has a checkout session against it, so a
# webhook that never lands can't strand someone who has actually paid.
STRIPE_WEBHOOK_SECRET=
# Price to unlock one report, in cents. Optional — defaults to 499 ($4.99).
REPORT_PRICE_CENTS=499

# ─────────────────────────────────────────────────────────────────────────────
# Spend guards. /api/generate is unauthenticated and every accepted call costs
# money: reports are generated IN FULL before the paywall, so this spend
# happens whether or not anyone pays. All optional — defaults shown.
# ─────────────────────────────────────────────────────────────────────────────

# Reports per day, per IP address and per email (lib/rateLimit.ts). Counted in
# Postgres, so the cap holds across serverless instances. Generous for a real
# person, tight for a script.
RATE_LIMIT_PER_IP_PER_DAY=10
RATE_LIMIT_PER_EMAIL_PER_DAY=5

# The largest transcript worth paying to read, in estimated tokens
# (lib/chunking.ts). File size is a poor proxy — a text export compresses ~10x
# — while estimated tokens tracks the bill almost directly. Anything above
# this fails fast with a message asking for a shorter export.
# This is a BUSINESS number: measure what a report at this size costs you
# against what you charge, and set it from that.
MAX_TRANSCRIPT_TOKENS=2000000
