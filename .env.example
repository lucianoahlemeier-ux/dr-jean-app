# ─────────────────────────────────────────────────────────────────────────────
# Chat Report MVP — environment variables
# Copy this file to `.env.local` and fill in real values. NEVER commit `.env*`.
# ─────────────────────────────────────────────────────────────────────────────

# Generation mode — WHERE the report-writing call goes. Same prompt in all three:
#   claude-code — local Claude Code CLI, your subscription, no API key (default, for dev)
#   api         — real Anthropic API, needs ANTHROPIC_API_KEY (for production)
#   mock        — canned sample report, no AI call at all
GEN_MODE=claude-code

# Anthropic — the one paid piece. Writes the report. Only read when GEN_MODE=api.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Optional: override the model. Defaults to claude-sonnet-5 (docs spec names Sonnet).
# Cheaper: claude-haiku-4-5. Dearer/sharper: claude-opus-4-8.
# Also used as the --model passed to the Claude Code CLI when GEN_MODE=claude-code.
ANTHROPIC_MODEL=claude-sonnet-5

# Large chats (see lib/chunking.ts) split into map-reduce: a cheap/fast model
# analyzes each chunk, the main model writes the final report from those
# analyses. Both optional — swap independently for A/B testing.
#   MAP_MODEL    — defaults to claude-haiku-4-5 if unset.
#   REDUCE_MODEL — defaults to ANTHROPIC_MODEL (above) if unset, i.e. the same
#                  model normal single-call chats already use.
MAP_MODEL=claude-haiku-4-5
REDUCE_MODEL=

# Inngest — runs the long generation job (free tier).
# From the Inngest dashboard → your app → Keys. For local dev with the Inngest
# Dev Server these can be left blank.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Supabase — stores the finished report + share tokens (free tier).
# Project Settings → API. Use the SERVICE ROLE key (server-side only, never
# expose to the browser).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — emails the report link (free tier). Optional — the link is the real
# deliverable, so the app still works without this (it just logs the link).
RESEND_API_KEY=
# The verified "from" address for report emails.
RESEND_FROM="{{PERSONA_NAME}} <reports@yourdomain.com>"

# Public base URL of the app — used to build the report link in emails.
NEXT_PUBLIC_APP_URL=http://localhost:3000
